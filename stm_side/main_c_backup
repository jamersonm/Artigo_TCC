void parse_data()
{
	// acumulador para média
	voc_ppb_acumulado = voc_ppb_acumulado + voc_semeatech.ppb;
	h2s_ppb_acumulado = h2s_ppb_acumulado + h2s_semeatech.ppb;
	so2_ppb_acumulado = so2_ppb_acumulado + so2_semeatech.ppb;
	nh3_ppb_acumulado = nh3_ppb_acumulado + nh3_semeatech.ppb;
	ch3sh_ppb_acumulado = ch3sh_ppb_acumulado + ch3sh_semeatech.ppb;
	// valores máximos
	voc_ppb_max = (voc_semeatech.ppb > voc_ppb_max) ? voc_semeatech.ppb : voc_ppb_max;
	h2s_ppb_max = (h2s_semeatech.ppb > h2s_ppb_max) ? h2s_semeatech.ppb : h2s_ppb_max;
	so2_ppb_max = (so2_semeatech.ppb > so2_ppb_max) ? so2_semeatech.ppb : so2_ppb_max;
	nh3_ppb_max = (nh3_semeatech.ppb > nh3_ppb_max) ? nh3_semeatech.ppb : nh3_ppb_max;
	ch3sh_ppb_max = (ch3sh_semeatech.ppb > ch3sh_ppb_max) ? ch3sh_semeatech.ppb : ch3sh_ppb_max;
	// valores mínimos
	voc_ppb_min = (voc_semeatech.ppb < voc_ppb_min) ? voc_semeatech.ppb : voc_ppb_min;
	h2s_ppb_min = (h2s_semeatech.ppb < h2s_ppb_min) ? h2s_semeatech.ppb : h2s_ppb_min;
	so2_ppb_min = (so2_semeatech.ppb < so2_ppb_min) ? so2_semeatech.ppb : so2_ppb_min;
	nh3_ppb_min = (nh3_semeatech.ppb < nh3_ppb_min) ? nh3_semeatech.ppb : nh3_ppb_min;
	ch3sh_ppb_min = (ch3sh_semeatech.ppb < ch3sh_ppb_min) ? ch3sh_semeatech.ppb : ch3sh_ppb_min;

	contador_amostragem++;
}

void build_packet(enum_get_sensors sensor){
	uint16_t aux_16;
	switch(sensor){
		case UART_STATE_GET_VOC:
			packet[0] = UART_STATE_GET_VOC;
			aux_16 = (uint16_t)(voc_semeatech.ppb);
			packet[1] = (aux_16 >> 8) & 0xFF;
			packet[2] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(voc_semeatech.temperature*100.0f);
			packet[3] = (aux_16 >> 8) & 0xFF;
			packet[4] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(voc_semeatech.humidity*100.0f);
			packet[5] = (aux_16 >> 8) & 0xFF;
			packet[6] = aux_16 & 0xFF;
			break;
		case UART_STATE_GET_H2S:
			packet[0] = UART_STATE_GET_H2S;
			aux_16 = (uint16_t)(h2s_semeatech.ppb);
			packet[1] = (aux_16 >> 8) & 0xFF;
			packet[2] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(h2s_semeatech.temperature*100.0f);
			packet[3] = (aux_16 >> 8) & 0xFF;
			packet[4] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(h2s_semeatech.humidity*100.0f);
			packet[5] = (aux_16 >> 8) & 0xFF;
			packet[6] = aux_16 & 0xFF;
			break;
		case UART_STATE_GET_SO2:
			packet[0] = UART_STATE_GET_SO2;
			aux_16 = (uint16_t)(so2_semeatech.ppb);
			packet[1] = (aux_16 >> 8) & 0xFF;
			packet[2] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(so2_semeatech.temperature*100.0f);
			packet[3] = (aux_16 >> 8) & 0xFF;
			packet[4] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(so2_semeatech.humidity*100.0f);
			packet[5] = (aux_16 >> 8) & 0xFF;
			packet[6] = aux_16 & 0xFF;
			break;
		case UART_STATE_GET_NH3:
			packet[0] = UART_STATE_GET_NH3;
			aux_16 = (uint16_t)(nh3_semeatech.ppb);
			packet[1] = (aux_16 >> 8) & 0xFF;
			packet[2] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(nh3_semeatech.temperature*100.0f);
			packet[3] = (aux_16 >> 8) & 0xFF;
			packet[4] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(nh3_semeatech.humidity*100.0f);
			packet[5] = (aux_16 >> 8) & 0xFF;
			packet[6] = aux_16 & 0xFF;
			break;
		case UART_STATE_GET_CH3SH:
			packet[0] = UART_STATE_GET_CH3SH;
			aux_16 = (uint16_t)(ch3sh_semeatech.ppb);
			packet[1] = (aux_16 >> 8) & 0xFF;
			packet[2] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(ch3sh_semeatech.temperature*100.0f);
			packet[3] = (aux_16 >> 8) & 0xFF;
			packet[4] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(ch3sh_semeatech.humidity*100.0f);
			packet[5] = (aux_16 >> 8) & 0xFF;
			packet[6] = aux_16 & 0xFF;
			break;
		case UART_STATE_GET_MICS:
			/*packet[1]  = 0x63  ; // id da medida 1 "c"pb
			packet[6]  = 0x6E  ; // id da medida 2 "n"g
			packet[11] = 0x6F  ; // id da medida 3 "o"emp
			packet[16] = 0x6C  ; // id da medida 4 nul"l"
			float_to_bytes(mics_co, temp_buffer);
			memcpy(&packet[2], temp_buffer, 4);
			float_to_bytes(mics_nh3, temp_buffer);
			memcpy(&packet[7], temp_buffer, 4);
			float_to_bytes(mics_no2, temp_buffer);
			memcpy(&packet[12], temp_buffer, 4);
			memset(&packet[17], 0, 4);
			break;*/
		case UART_STATE_GET_BME:
			packet[0] = UART_STATE_GET_BME;
			aux_16 = (uint16_t)(bme.temp*100.0f);
			packet[1] = (aux_16 >> 8) & 0xFF;
			packet[2] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(bme.pres - 90000);
			packet[3] = (aux_16 >> 8) & 0xFF;
			packet[4] = aux_16 & 0xFF;
			aux_16 = (uint16_t)(bme.humid*100.0f);
			packet[5] = (aux_16 >> 8) & 0xFF;
			packet[6] = aux_16 & 0xFF;
			break;
		case UART_STATE_GET_ANEMO:
			packet[0] = UART_STATE_GET_ANEMO;
			packet[1] = (uint8_t)anemo.direcao;
			packet[2] = (uint8_t)anemo.vel_ms;
			packet[3] = 0;
			packet[4] = 0;
			packet[5] = 0;
			packet[6] = 0;
			break;
		default:
			// Limpa os dados em caso de sensor inválido
			memset(&packet[0], 0, 8);
			break;
	}

	uint8_t xor_checksum = 0;
	for (int i = 0; i < 7; i++) {
	    xor_checksum ^= packet[i];
	}
	packet[7] = xor_checksum;
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
    if (huart->Instance == USART1) {
      build_packet(rx_received[0]);
      
      HAL_UART_AbortTransmit(huart);
      HAL_UART_Transmit_DMA(&huart1, packet, 8);
      HAL_UART_Receive_DMA(&huart1, rx_received, 1);
    }
}

