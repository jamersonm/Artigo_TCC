// Comparison function for floats
int compare_floats(const void* a, const void* b) {
    float fa = *(const float*)a;
    float fb = *(const float*)b;
    return (fa > fb) - (fa < fb);  // returns 1 if fa > fb, -1 if fa < fb, 0 if equal
}

void controleUmidade()
{
	int size = 5;
	float umidade_media = 0;

	float umidade_semeatech[] = {voc_semeatech.humidity, h2s_semeatech.humidity, so2_semeatech.humidity, nh3_semeatech.humidity, ch3sh_semeatech.humidity};

    qsort(umidade_semeatech, size, sizeof(float), compare_floats);

    //CALCULA A UMIDADE MEDIA NAO LEVANDO EM CONTA O MENOR E MAIOR VALOR
    umidade_media = umidade_semeatech[1] + umidade_semeatech[2] + umidade_semeatech[3];
    umidade_media = umidade_media/(size-2);

    if(umidade_media >= 75) {
    	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_4, 3277); //DUTY CYCLE 20%
    }
    else {
    	__HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_4, 0); //DUTY CYCLE 0%
    }
}


void readVelDirVento(ANEMO *s)
{
	uint32_t dir_vento  = adc1_dma_result[8]*3300/4095;
	uint32_t vel_vento = adc2_dma_result[5]*3300/4095;
	s->vel_ms = 0;

	if(dir_vento < 835)
		s->direcao = Norte_Nordeste;
	else if(dir_vento >= 835 && dir_vento < 1165)
		s->direcao = Leste_Nordeste;
	else if(dir_vento >= 1165 && dir_vento < 1495)
		s->direcao = Leste_Sudeste;
	else if(dir_vento >= 1495 && dir_vento < 1820)
		s->direcao = Sul_Sudeste;
	else if(dir_vento >= 1820 && dir_vento < 2145)
		s->direcao = Sul_Sudoeste;
	else if(dir_vento >= 2145 && dir_vento < 2465)
		s->direcao = Oeste_Sudoeste;
	else if(dir_vento >= 2465 && dir_vento < 2795)
		s->direcao = Oeste_Noroeste;
	else if(dir_vento >= 2465 && dir_vento < 2795)
		s->direcao = Norte_Noroeste;

	if(vel_vento < 559)
		s->vel_ms = (13.42/1000)*vel_vento -7.5;
}



